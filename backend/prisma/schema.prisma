// ============================================================
// Mediko Bazaar — Prisma Schema for MySQL Database
// Complete Healthcare Commerce & Operational Ecosystem
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  INTERNATIONAL_SELLER
  ENGINEER
  ADMIN
  SUPPORT
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  CORRECTION_REQUIRED
}

enum ProductType {
  NEW
  RENTAL
  CERTIFIED_PRE_OWNED
  SPARE_PART
  CONSUMABLE
  HOME_CARE
}

enum ConditionGrade {
  BRAND_NEW
  GRADE_A
  GRADE_B
  GRADE_C
  REFURBISHED
}

enum RentalStatus {
  REQUESTED
  APPROVED
  DEPOSIT_PAID
  DISPATCHED
  ACTIVE
  RETURN_REQUESTED
  INSPECTED
  COMPLETED
  CANCELLED
}

enum ServiceType {
  INSTALLATION
  CALIBRATION
  PREVENTIVE_MAINTENANCE
  REPAIR
  AMC
  INSPECTION
  DEMONSTRATION
}

enum TicketStatus {
  NEW
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CLOSED
}

enum EnquiryType {
  RFQ
  ASK_FOR_PRICE
  B2B_BULK
  IMPORT_CALCULATION
  SPARE_PART_ENQUIRY
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceType {
  SALES_TAX_INVOICE
  RENTAL_FEE
  RENTAL_PENALTY
  SERVICE_REPAIR
  IMPORT_LOGISTICS
}

// ------------------------------------------------------------
// User & Authentication Model
// ------------------------------------------------------------
model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  passwordHash     String             @default("pbkdf2_demo_hash")
  fullName         String
  role             Role               @default(CUSTOMER)
  phone            String?
  organization     String?
  address          String?
  city             String?            @default("Kathmandu")
  kycStatus        KYCStatus          @default(NOT_SUBMITTED)
  panVatNumber     String?
  businessLicense  String?
  avatar           String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  products         Product[]          @relation("VendorProducts")
  rentalBookings   RentalBooking[]    @relation("CustomerRentals")
  serviceRequests  ServiceBooking[]   @relation("CustomerServices")
  assignedServices ServiceBooking[]   @relation("EngineerServices")
  enquiries        Enquiry[]          @relation("CustomerEnquiries")
  orders           Order[]            @relation("CustomerOrders")
  invoices         Invoice[]          @relation("CustomerInvoices")
  supportTickets   SupportTicket[]    @relation("CustomerTickets")
  sentMessages     ChatMessage[]      @relation("SentMessages")
  refreshTokens    RefreshToken[]

  @@index([role])
  @@index([email])
}

// ------------------------------------------------------------
// Category Model
// ------------------------------------------------------------
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  icon        String?
  itemCount   Int       @default(0)
  color       String?   @default("#EFF6FF")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

// ------------------------------------------------------------
// Product & Catalog Model
// ------------------------------------------------------------
model Product {
  id                   Int              @id @default(autoincrement())
  title                String
  slug                 String           @unique
  brand                String
  model                String
  sku                  String           @unique
  categoryId           Int
  category             Category         @relation(fields: [categoryId], references: [id])
  sellerId             Int?
  seller               User?            @relation("VendorProducts", fields: [sellerId], references: [id])
  sellerName           String           @default("Mediko Official")
  sellerVerified       Boolean          @default(true)
  type                 ProductType      @default(NEW)
  condition            String           @default("New")
  conditionGrade       ConditionGrade?  @default(BRAND_NEW)
  yearOfManufacture    Int?
  usageHours           Int?             @default(0)
  inspectionStatus     String?          @default("Passed")
  verificationStatus   String?          @default("Verified")
  price                Decimal?         @db.Decimal(12, 2)
  oldPrice             Decimal?         @db.Decimal(12, 2)
  askForPrice          Boolean          @default(false)
  currency             String           @default("NPR")
  inStock              Boolean          @default(true)
  stockCount           Int              @default(10)
  discount             Int              @default(0)
  rating               Decimal          @default(4.8) @db.Decimal(3, 2)
  reviewsCount         Int              @default(0)
  badge                String?
  image                String           @db.Text
  gallery              Json?
  description          String           @db.Text
  specifications       Json?
  features             Json?
  warrantyPeriod       String?          @default("1 Year")
  warrantyDetails      String?          @db.Text
  installationAvailable Boolean         @default(false)
  engineerSupport      Boolean          @default(false)
  trainingAvailable    Boolean          @default(false)
  forHospital          Boolean          @default(true)
  forHomeCare          Boolean          @default(false)

  // Rental specific fields
  rentalDaily          Decimal?         @db.Decimal(10, 2)
  rentalWeekly         Decimal?         @db.Decimal(10, 2)
  rentalMonthly        Decimal?         @db.Decimal(10, 2)
  rentalDeposit        Decimal?         @db.Decimal(10, 2)
  rentalPenaltyDaily   Decimal?         @db.Decimal(10, 2)

  // Spare parts fields
  partNumber           String?
  isOEM                Boolean          @default(false)
  compatibleEquipment  Json?

  isApproved           Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  rentalBookings       RentalBooking[]
  serviceBookings      ServiceBooking[]
  enquiries            Enquiry[]

  @@index([type])
  @@index([categoryId])
  @@index([brand])
}

// ------------------------------------------------------------
// Rental Management & Deposit / Penalty Escrow
// ------------------------------------------------------------
model RentalBooking {
  id                   Int              @id @default(autoincrement())
  bookingNumber        String           @unique
  customerId           Int
  customer             User             @relation("CustomerRentals", fields: [customerId], references: [id])
  productId            Int
  product              Product          @relation(fields: [productId], references: [id])
  durationType        String           @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  durationValue        Int              @default(1)
  startDate            DateTime
  endDate              DateTime
  rentAmount           Decimal          @db.Decimal(10, 2)
  depositAmount        Decimal          @db.Decimal(10, 2)
  status               RentalStatus     @default(REQUESTED)
  penaltyAmount        Decimal          @default(0.00) @db.Decimal(10, 2)
  penaltyReason        String?
  returnDate           DateTime?
  conditionCheckNotes  String?          @db.Text
  engineerInspection   Json?
  deliveryAddress      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  invoices             Invoice[]

  @@index([status])
  @@index([customerId])
}

// ------------------------------------------------------------
// Biomedical Engineering & Service Booking
// ------------------------------------------------------------
model ServiceBooking {
  id                   Int              @id @default(autoincrement())
  ticketNumber         String           @unique
  customerId           Int
  customer             User             @relation("CustomerServices", fields: [customerId], references: [id])
  engineerId           Int?
  engineer             User?            @relation("EngineerServices", fields: [engineerId], references: [id])
  productId            Int?
  product              Product?         @relation(fields: [productId], references: [id])
  equipmentTitle       String
  equipmentBrand       String
  equipmentModel       String?
  serialNumber         String?
  serviceType          ServiceType      @default(REPAIR)
  problemDescription   String           @db.Text
  hospitalLocation     String
  preferredDate        DateTime?
  scheduledDate        DateTime?
  status               TicketStatus     @default(NEW)
  partsRequired        String?
  resolutionNotes      String?          @db.Text
  engineerNotes        String?          @db.Text
  signedReportUrl      String?
  checklist            Json?
  cost                 Decimal?         @db.Decimal(10, 2)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  invoices             Invoice[]
  chatMessages         ChatMessage[]

  @@index([status])
  @@index([engineerId])
  @@index([customerId])
}

// ------------------------------------------------------------
// Enquiry & RFQ Management
// ------------------------------------------------------------
model Enquiry {
  id                   Int              @id @default(autoincrement())
  enquiryNumber        String           @unique
  customerId           Int
  customer             User             @relation("CustomerEnquiries", fields: [customerId], references: [id])
  productId            Int?
  product              Product?         @relation(fields: [productId], references: [id])
  enquiryType          EnquiryType      @default(RFQ)
  title                String
  quantity             Int              @default(1)
  targetPrice          Decimal?         @db.Decimal(12, 2)
  currency             String           @default("NPR")
  countryOfOrigin      String?
  shippingMode         String?          @default("AIR")
  destination          String?          @default("Kathmandu, Nepal")
  hsCode               String?
  notes                String?          @db.Text
  attachments          Json?
  status               String           @default("NEW") // NEW, UNDER_REVIEW, QUOTATION_SENT, CONVERTED, CLOSED
  assignedTo           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  landingCostEstimate  LandingCostEstimate?
  quotations           Quotation[]
  chatMessages         ChatMessage[]

  @@index([enquiryType])
  @@index([status])
}

// ------------------------------------------------------------
// Nepal Import Landing Cost Engine
// ------------------------------------------------------------
model LandingCostEstimate {
  id                   Int       @id @default(autoincrement())
  enquiryId            Int       @unique
  enquiry              Enquiry   @relation(fields: [enquiryId], references: [id])
  productPriceUSD      Decimal   @db.Decimal(12, 2)
  exchangeRateNPR      Decimal   @default(134.50) @db.Decimal(8, 2)
  productCostNPR       Decimal   @db.Decimal(12, 2)
  freightUSD           Decimal   @default(0.00) @db.Decimal(10, 2)
  insuranceUSD         Decimal   @default(0.00) @db.Decimal(10, 2)
  customsDutyPercent   Decimal   @default(5.00) @db.Decimal(5, 2)
  customsDutyNPR       Decimal   @db.Decimal(12, 2)
  vatPercent           Decimal   @default(13.00) @db.Decimal(5, 2)
  vatNPR               Decimal   @db.Decimal(12, 2)
  portClearanceNPR     Decimal   @default(25000.00) @db.Decimal(10, 2)
  bankForexCommissionNPR Decimal @default(8500.00) @db.Decimal(10, 2)
  localTransportNPR    Decimal   @default(12000.00) @db.Decimal(10, 2)
  medikoCommissionNPR  Decimal   @default(35000.00) @db.Decimal(10, 2)
  totalLandingCostNPR  Decimal   @db.Decimal(12, 2)
  marginPercent        Decimal   @default(10.00) @db.Decimal(5, 2)
  finalQuotationPriceNPR Decimal @db.Decimal(12, 2)
  breakdownJson        Json?
  createdAt            DateTime  @default(now())
}

// ------------------------------------------------------------
// Quotation Model
// ------------------------------------------------------------
model Quotation {
  id                   Int              @id @default(autoincrement())
  quotationNumber      String           @unique
  enquiryId            Int
  enquiry              Enquiry          @relation(fields: [enquiryId], references: [id])
  totalBaseAmount      Decimal          @db.Decimal(12, 2)
  freightAmount        Decimal          @default(0.00) @db.Decimal(10, 2)
  customsDuty          Decimal          @default(0.00) @db.Decimal(10, 2)
  vatAmount            Decimal          @default(0.00) @db.Decimal(10, 2)
  commission           Decimal          @default(0.00) @db.Decimal(10, 2)
  grandTotal           Decimal          @db.Decimal(12, 2)
  currency             String           @default("NPR")
  validityDays         Int              @default(15)
  expiresAt            DateTime
  status               QuotationStatus  @default(DRAFT)
  terms                String?          @db.Text
  pdfUrl               String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  orders               Order[]

  @@index([status])
}

// ------------------------------------------------------------
// Order Model
// ------------------------------------------------------------
model Order {
  id                   Int              @id @default(autoincrement())
  orderNumber          String           @unique
  customerId           Int
  customer             User             @relation("CustomerOrders", fields: [customerId], references: [id])
  quotationId          Int?
  quotation            Quotation?       @relation(fields: [quotationId], references: [id])
  items                Json
  subtotal             Decimal          @db.Decimal(12, 2)
  vatAmount            Decimal          @default(0.00) @db.Decimal(12, 2)
  totalAmount          Decimal          @db.Decimal(12, 2)
  paymentStatus        String           @default("PENDING") // PENDING, PAID, PARTIAL, REFUNDED
  paymentMethod        String           @default("ESEWA") // ESEWA, KHALTI, FONEPAY, BANK_TRANSFER, CASH_ON_DELIVERY
  deliveryStatus       OrderStatus      @default(PENDING)
  shippingAddress      Json?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  invoices             Invoice[]

  @@index([deliveryStatus])
  @@index([customerId])
}

// ------------------------------------------------------------
// Legal Tax Invoice Model
// ------------------------------------------------------------
model Invoice {
  id                   Int              @id @default(autoincrement())
  invoiceNumber        String           @unique
  orderId              Int?
  order                Order?           @relation(fields: [orderId], references: [id])
  rentalBookingId      Int?
  rentalBooking        RentalBooking?   @relation(fields: [rentalBookingId], references: [id])
  serviceBookingId     Int?
  serviceBooking       ServiceBooking?  @relation(fields: [serviceBookingId], references: [id])
  customerId           Int
  customer             User             @relation("CustomerInvoices", fields: [customerId], references: [id])
  invoiceType          InvoiceType      @default(SALES_TAX_INVOICE)
  subtotal             Decimal          @db.Decimal(12, 2)
  vatAmount            Decimal          @default(0.00) @db.Decimal(12, 2)
  penaltyDeduction     Decimal          @default(0.00) @db.Decimal(10, 2)
  depositRefund        Decimal          @default(0.00) @db.Decimal(10, 2)
  grandTotal           Decimal          @db.Decimal(12, 2)
  paymentStatus        String           @default("PAID")
  issueDate            DateTime         @default(now())
  dueDate              DateTime?
  pdfUrl               String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([invoiceNumber])
  @@index([customerId])
}

// ------------------------------------------------------------
// Support & Internal Communication
// ------------------------------------------------------------
model SupportTicket {
  id                   Int              @id @default(autoincrement())
  ticketNumber         String           @unique
  customerId           Int
  customer             User             @relation("CustomerTickets", fields: [customerId], references: [id])
  subject              String
  category             String           @default("GENERAL")
  priority             String           @default("MEDIUM")
  status               String           @default("OPEN")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  messages             ChatMessage[]

  @@index([status])
}

model ChatMessage {
  id                   Int              @id @default(autoincrement())
  ticketId             Int?
  ticket               SupportTicket?   @relation(fields: [ticketId], references: [id])
  enquiryId            Int?
  enquiry              Enquiry?         @relation(fields: [enquiryId], references: [id])
  serviceBookingId     Int?
  serviceBooking       ServiceBooking?  @relation(fields: [serviceBookingId], references: [id])
  senderId             Int
  sender               User             @relation("SentMessages", fields: [senderId], references: [id])
  senderName           String
  senderRole           Role
  message              String           @db.Text
  attachmentUrl        String?
  createdAt            DateTime         @default(now())

  @@index([ticketId])
  @@index([enquiryId])
  @@index([serviceBookingId])
}

// ------------------------------------------------------------
// Enterprise JWT Refresh Token Store for Rotation & Revocation
// ------------------------------------------------------------
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(191)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

